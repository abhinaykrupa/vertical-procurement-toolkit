#!/bin/sh
# Pre-push gate: run the full local check suite. Bypass once with `git push --no-verify`.
set -e
cd "$(git rev-parse --show-toplevel)"
if [ ! -x .venv/bin/python ] && [ -z "$PYTHON" ]; then
    echo "pre-push: .venv missing. Run 'make install' first (or set PYTHON=...)." >&2
    exit 1
fi
echo "pre-push: running make check"
exec make check
